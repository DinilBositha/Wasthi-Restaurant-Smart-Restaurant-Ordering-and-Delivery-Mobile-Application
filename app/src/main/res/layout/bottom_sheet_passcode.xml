<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/white_circle_bg"
        android:backgroundTint="@color/md_theme_outlineVariant" />

    <!-- Icon -->
    <ImageView
        android:id="@+id/imgPasscodeIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ic_passcode"
        app:tint="?attr/colorPrimary" />

    <!-- Title -->
    <TextView
        android:id="@+id/txtPasscodeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Passcode"
        android:textColor="@color/md_theme_onSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtPasscodeSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Enter your 4-digit security PIN"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="14sp" />

    <!-- 4 PIN Dots -->
    <LinearLayout
        android:id="@+id/layoutPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:src="@drawable/pin_dot_empty" />

        <ImageView
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:src="@drawable/pin_dot_empty" />
    </LinearLayout>

    <!-- Error Message -->
    <TextView
        android:id="@+id/txtPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/md_theme_error"
        android:textSize="13sp"
        android:visibility="invisible" />

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="true">

        <!-- Row 1 -->
        <TextView
            android:id="@+id/key1"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/key2"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/key3"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Row 2 -->
        <TextView
            android:id="@+id/key4"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/key5"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/key6"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="6"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Row 3 -->
        <TextView
            android:id="@+id/key7"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="7"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/key8"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/key9"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="9"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Row 4 -->
        <ImageButton
            android:id="@+id/btnBiometricKey"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:contentDescription="Fingerprint"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_fingerprint"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/key0"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/md_theme_onSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDeleteKey"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_num_key"
            android:contentDescription="Delete"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_backspace"
            app:tint="@color/md_theme_onSurface" />

    </GridLayout>

    <!-- Alternative Action / Cancel Button -->
    <Button
        android:id="@+id/btnUsePassword"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Use Email &amp; Password Instead"
        android:textColor="?attr/colorPrimary" />

</LinearLayout>
